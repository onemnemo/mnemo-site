---
/**
 * Illustrative forgetting curve, after Ebbinghaus. Static SVG, no JS.
 * Shows decay without review vs retention with spaced reviews.
 */
---

<figure class="curve-figure">
  <svg
    viewBox="0 0 640 360"
    role="img"
    aria-label="Illustrative chart of the forgetting curve. Without review, retention falls steeply within days. With spaced reviews on days one, three, and seven, retention recovers each time and the decay flattens."
  >
    <!-- gridlines -->
    <g class="grid">
      <line x1="60" y1="40" x2="620" y2="40"></line>
      <line x1="60" y1="110" x2="620" y2="110"></line>
      <line x1="60" y1="180" x2="620" y2="180"></line>
      <line x1="60" y1="250" x2="620" y2="250"></line>
      <line x1="60" y1="320" x2="620" y2="320"></line>
    </g>

    <!-- y labels -->
    <g class="axis-label" text-anchor="end">
      <text x="50" y="44">100%</text>
      <text x="50" y="184">50%</text>
      <text x="50" y="324">0%</text>
    </g>

    <!-- x labels -->
    <g class="axis-label" text-anchor="middle">
      <text x="60" y="344">Day 0</text>
      <text x="100" y="344">1</text>
      <text x="180" y="344">3</text>
      <text x="340" y="344">7</text>
      <text x="620" y="344">14</text>
    </g>

    <!-- without review -->
    <path
      class="line-forget"
      d="M60,40 C75,90 85,140 100,166 C115,190 125,196 140,202 C155,208 165,219 180,225 C210,236 230,240 260,244 C290,250 310,255 340,258 C380,263 420,267 460,270 C510,273 570,276 620,278"
    ></path>

    <!-- with spaced review -->
    <path
      class="line-review"
      d="M60,40 C75,90 85,140 100,166 L100,46 C130,62 155,88 180,110 L180,46 C230,57 290,70 340,82 L340,46 C430,54 530,64 620,74"
    ></path>

    <!-- review markers -->
    <g class="review-dots">
      <circle cx="100" cy="46" r="5"></circle>
      <circle cx="180" cy="46" r="5"></circle>
      <circle cx="340" cy="46" r="5"></circle>
    </g>

    <!-- legend -->
    <g class="legend">
      <line x1="380" y1="120" x2="404" y2="120" class="line-review"></line>
      <text x="412" y="124">With spaced review</text>
      <line x1="380" y1="146" x2="404" y2="146" class="line-forget"></line>
      <text x="412" y="150">Without review</text>
    </g>
  </svg>
  <figcaption class="small muted">
    Illustrative, after Ebbinghaus. Dots mark review sessions. Real curves vary
    by person and material.
  </figcaption>
</figure>

<style>
  .curve-figure {
    margin: 0;
  }

  svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .grid line {
    stroke: var(--border);
    stroke-width: 1;
  }

  .axis-label text,
  .legend text {
    font-size: 13px;
    fill: var(--ink-faint);
    font-family: inherit;
  }

  .legend text {
    fill: var(--ink-secondary);
  }

  .line-forget {
    fill: none;
    stroke: var(--ink-faint);
    stroke-width: 2.5;
    stroke-dasharray: 6 6;
    stroke-linecap: round;
  }

  .line-review {
    fill: none;
    stroke: var(--accent);
    stroke-width: 3;
    stroke-linecap: round;
  }

  .review-dots circle {
    fill: var(--accent);
    stroke: var(--bg);
    stroke-width: 2;
  }

  figcaption {
    margin-top: 0.75rem;
  }
</style>
