---
import Base from "../layouts/Base.astro";
---

<Base
  title="Page not found, Mnemo"
  description="The page you were looking for does not exist."
>
  <section class="section nf">
    <div class="container-narrow">
      <span class="eyebrow">404</span>
      <h1>This page has been forgotten</h1>
      <p class="lede">
        Fitting, for a study app. The page you were looking for does not exist
        or has moved.
      </p>
      <div class="nf-actions">
        <a class="btn btn-primary" href="/">Back to the homepage</a>
        <a class="btn btn-secondary" href="/download">Download Mnemo</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    text-align: center;
    padding-block: clamp(6rem, 4rem + 8vw, 11rem);
  }

  .nf .lede {
    margin-inline: auto;
  }

  .nf-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }
</style>
